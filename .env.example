# Скопируйте в .env и подставьте СВОИ значения. Файл .env в git не попадает.
DB_URL=jdbc:postgresql://localhost:5432/library
DB_USER=library_user
DB_PASSWORD=<придумайте-надёжный-пароль>
# Минимум 32 символа, случайная строка. Пример генерации: openssl rand -base64 48
JWT_SECRET=<случайная-строка-не-короче-32-символов>
JWT_EXP_MIN=60
# Первый администратор (создаётся при старте, если заданы оба значения)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<пароль-администратора-не-короче-8-символов>
